meta {
  name: Login
  type: http
  seq: 2
}

post {
  url: {{host}}/user/login
  body: json
  auth: none
}

body:json {
  {
    "username": "testing",
    "password": "Test1234."
  }
}

script:post-response {
  const body = res.getBody();
  if (body && body.token) {
    bru.setVar("token", body.token);
    console.log("Token guardado en la variable de colección 'token'");
  } else {
    console.log("No se encontró token en la respuesta:", body);
  }
}

docs {
  Migrado a Postgres. El JWT tiene la misma forma que antes de la migración
  (`{id, cuit}`), así que sigue siendo válido para los módulos que todavía
  no migraron.
}
