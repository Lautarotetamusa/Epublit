meta {
  name: Login
  type: http
  seq: 2
}

post {
  url: {{host}}/user/login
  body: json
  auth: none
}

body:json {
  {
    "identifier": "ana@editorial.com",
    "password": "Test1234."
  }
}

script:post-response {
  const body = res.getBody();
  if (body && body.token) {
    bru.setVar("token", body.token);
    console.log("Token guardado en la variable de colección 'token'");
  } else {
    console.log("No se encontró token en la respuesta:", body);
  }
}

docs {
  `identifier` es un email o un username: con `@` se busca por email
  (normalizado, sin distinguir mayúsculas), sin `@` por username exacto (las
  cuentas viejas siguen entrando con su usuario).

  - 200 `{ success, message, token }`. El JWT es `{id, cuit}`.
  - 401 `invalid_credentials`: no existe, contraseña incorrecta o cuenta
    pendiente vencida (se borra en ese momento).
  - 403 `email_not_verified` (+ `email`): contraseña correcta pero la cuenta
    nueva todavía no confirmó el email. Las cuentas viejas nunca lo reciben.

  Errores: `{ success: false, errors: [{ code, message, field?, email? }] }`.
}
