meta {
  name: Create
  type: http
  seq: 1
}

post {
  url: {{host}}/ventaConsignacion
  body: json
  auth: inherit
}

body:json {
  {
    "cliente": 1,
    "medio_pago": "efectivo",
    "tipo_cbte": 11,
    "descuento": 0,
    "fecha_venta": "2024-01-15",
    "libros": [
      {
        "isbn": "9789874864674",
        "cantidad": 2
      }
    ]
  }
}

docs {
  Sin migrar (MySQL). Venta de libros que estaban en consignación en el
  cliente; a diferencia de `Venta/Create` lleva `fecha_venta`. Tiene su
  propio `GET /ventaConsignacion` y `GET /ventaConsignacion/:id` (ver los
  otros requests de esta carpeta).
}
