    "dependencies": {
        "bcrypt": "^5.1.0",
        "bradb": "^3.1.6",
        "cors": "^2.8.5",
        "dotenv": "^16.0.3",
        "drizzle-orm": "^0.44.7",
        "express": "^5.1.0",
        "jsonwebtoken": "^9.0.0",
        "multer": "^1.4.5-lts.1",
        "node-forge": "^1.3.1",
        "pg": "^8.23.0",
        "puppeteer": "^25.11.0",
        "qrcode": "^1.5.1",
        "soap": "^1.0.0",
        "xml2js": "^0.6.0",
        "zod": "^4.1.5"
    },
    "devDependencies": {
        "@babel/preset-typescript": "^7.24.1",
        "@eslint/js": "^9.9.0",
        "@types/bcrypt": "^5.0.0",
        "@types/cors": "^2.8.13",
        "@types/dotenv": "^8.2.0",
        "@types/express": "^5.0.3",
        "@types/jsonwebtoken": "^9.0.0",
        "@types/multer": "^1.4.12",
        "@types/node": "^24.0.0",
        "@types/pg": "^8.23.1",
        "@types/qrcode": "^1.5.1",
        "@types/sax": "^1.2.4",
        "@types/soap": "^0.21.0",
        "@types/supertest": "^6.0.2",
        "@vitest/coverage-v8": "^5.0.1",
        "drizzle-kit": "^0.31.11",
        "drizzle-seed": "^0.3.1",
        "drizzle-zod": "^0.8.3",
        "eslint": "^9.9.0",
        "eslint-plugin-complexity": "^1.0.2",
        "eslint-plugin-sonarjs": "^4.2.1",
        "forever": "^4.0.3",
        "globals": "^15.9.0",
        "jscpd": "^5.3.2",
        "madge": "^8.0.0",
        "nodemon": "^3.0.3",
        "supertest": "^6.3.4",
        "ts-node": "^10.9.2",
        "tsc-alias": "^1.9.5",
        "tsconfig-paths": "^4.2.0",
        "typescript": "^5.9.3",
        "typescript-eslint": "^8.0.1",
        "vitest": "^5.0.1"
    },
    "name": "Epublit",
    "type": "commonjs",
    "version": "1.0.0",
    "main": "src/index.ts",
    "keywords": [],
    "author": "Lautaro Teta Musa",
    "license": "ISC",
    "description": "",
    "scripts": {
        "background": "forever start -o logs.log -e logs.log -v -c ts-node src/index.ts",
        "stop": "forever stopall",
        "logs": "tail -f logs.log",
        "dev": "NODE_OPTIONS='--tls-cipher-list=ECDHE-RSA-AES128-GCM-SHA256' nodemon --ignore afipkeys/ src/index.ts",
        "start:prod": "node --tls-cipher-list='ECDHE-RSA-AES128-GCM-SHA256' dist/src/index.js",
        "build": "rm -rf ./dist/ && tsc && tsc-alias && cp -r ./src/lib/afip/afip.js/src/Afip_res/ ./dist/src/lib/afip/afip.js/src/Afip_res",
        "lint": "eslint src/",
        "lint:cycles": "madge --circular --extensions ts src",
        "lint:duplicates": "jscpd src --min-lines 4 --min-tokens 30",
        "docs:api": "node scripts/generate-api-docs.js",
        "test:setup": "./scripts/reset-test-db.sh",
        "test": "./scripts/reset-test-db.sh && DB_NAME=epublit_test npx vitest run",
        "test:coverage": "./scripts/reset-test-db.sh && DB_NAME=epublit_test npx vitest run --coverage",
        "seed": "ts-node seeders/index.ts",
        "db:generate": "drizzle-kit generate",
        "db:migrate": "drizzle-kit migrate",
        "db:migrate:run": "ts-node src/db/migrate.ts",
        "db:studio": "drizzle-kit studio"
    }
}
