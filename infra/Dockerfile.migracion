# syntax=docker/dockerfile:1

# ---------------------------------------------------------------------------
# Imagen efímera para la migración de datos de producción
# (specs/015-migracion-produccion). No es la imagen de la app: incluye
# devDependencies (mysql2, ts-node) y el script, y se descarta al terminar.
#
# Se construye con contexto en la raíz del repo:
#   docker compose -f infra/docker-compose.yml --profile tools \
#     build migracion
# ---------------------------------------------------------------------------
FROM node:22-bookworm-slim

WORKDIR /app

ENV PUPPETEER_SKIP_CHROMIUM_DOWNLOAD=true

COPY back/package*.json ./
RUN --mount=type=cache,target=/root/.npm \
    if [ -f package-lock.json ]; then npm ci; else npm install; fi

COPY back/tsconfig.json ./
COPY back/scripts/migracion-produccion ./scripts/migracion-produccion

ENTRYPOINT ["npx", "ts-node", "scripts/migracion-produccion/index.ts"]
