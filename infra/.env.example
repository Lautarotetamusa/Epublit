# =============================================================================
# Epublit — variables de producción
#
# Copiar a /home/Epublit/.env en el servidor (o cargar el mismo contenido en el
# secret ENV_FILE_CONTENT de GitHub). NO commitear.
#
# El compose lee este archivo y además fija/deriva algunas variables para los
# contenedores; quedan anotadas abajo para que no sorprenda que un cambio acá
# no tenga efecto dentro de Docker.
# =============================================================================

# --- Borde (nginx / compose) ------------------------------------------------
# Dominio público, sin protocolo.
DOMAIN=epublit.com.ar
# Origen público de la API, sin barra final. El back lo usa como HOST para
# armar las URLs de /files, y el deploy deriva de acá VITE_API_URL
# (`${PUBLIC_URL}/api`) para el build del front.
PUBLIC_URL=https://epublit.com.ar
# Base pública de la API cuando nginx recorta /api (el back la usa para
# webhooks y callbacks).
PUBLIC_API_URL=https://epublit.com.ar/api

# Origen(es) del front que pueden llamar a la API, separados por coma.
# Ej: el sitio interno en app.epublit.com.ar y la landing en epublit.com.ar.
CORS_ORIGIN=https://app.epublit.com.ar

# Cantidad de proxies (nginx) entre internet y el back. El back la usa para
# leer la IP real del cliente en X-Forwarded-For (rate limit de la tienda).
# Obligatoria en prod: 1 si solo está el nginx del host delante del back.
TRUST_PROXY=1

# Email para Let's Encrypt (avisos de vencimiento).
LETSENCRYPT_EMAIL=admin@epublit.com.ar
# 1 = entorno de staging de Let's Encrypt (para probar sin gastar límites).
LETSENCRYPT_STAGING=0

# Puerto del back publicado en el host (loopback) para el nginx del server.
# El contenedor siempre escucha en 3000; esto es el puerto de afuera.
BACK_PORT=3001

# Imagen del back. Opcional: el compose usa este tag por defecto.
BACK_IMAGE=ghcr.io/lautarotetamusa/epublit-back:prod

# --- Backend ----------------------------------------------------------------
# Entorno de ejecución: dev | staging | prod.
# (el compose lo fija en prod)
NODE_ENV=prod
# Puerto interno de Express. (el compose lo fija en 3000)
PORT=3000
# URL pública con la que el back arma las URLs de /files.
# (el compose la toma de PUBLIC_URL)
HOST=https://epublit.com.ar
# Carpeta donde se guardan/sirven los archivos generados (facturas, remitos,
# logos, portadas, fotos), relativa al cwd del proceso.
# (el compose la fija en /app/files)
FILES_PATH=files
# Zona horaria del proceso. (el Dockerfile ya la fija en Buenos Aires)
TZ=America/Argentina/Buenos_Aires

# --- Seguridad --------------------------------------------------------------
JWT_SECRET=cambiar_por_un_secreto_largo_y_aleatorio
# Formato de jsonwebtoken: 15m, 24h, 7d, etc.
JWT_EXPIRES_IN=24h
# Clave para cifrar tokens de MercadoPago y credenciales de Correo Argentino.
# Usar un secreto largo y distinto de JWT_SECRET.
CREDENTIALS_ENCRYPTION_KEY=cambiar_por_un_secreto_largo_y_aleatorio

# --- Tienda online: MercadoPago (app global) --------------------------------
MP_CLIENT_ID=
MP_CLIENT_SECRET=
# El callback va al API (dominio raíz), no al panel app.
MP_REDIRECT_URI=https://epublit.com.ar/api/tienda/mercadopago/callback
MP_WEBHOOK_SECRET=
MP_API_BASE_URL=https://api.mercadopago.com
MP_AUTH_BASE_URL=https://auth.mercadopago.com
MP_PANEL_URL=https://app.epublit.com.ar

# --- Tienda online: Correo Argentino ----------------------------------------
# Producción por defecto. Para QA:
# MICORREO_BASE_URL=https://apitest.correoargentino.com.ar/micorreo/v1
# PAQAR_BASE_URL=https://apitest.correoargentino.com.ar/paqar/v1
MICORREO_BASE_URL=https://api.correoargentino.com.ar/micorreo/v1
PAQAR_BASE_URL=https://api.correoargentino.com.ar/paqar/v1

# --- AFIP -------------------------------------------------------------------
# CUIT con el que se consulta el padrón (no es el de cada cuenta).
# Tiene que ser un CUIT válido de 11 dígitos con dígito verificador.
AFIP_CUIT_PROD=20123456786

# --- Postgres ---------------------------------------------------------------
# Dentro de los contenedores el compose fija DB_HOST=db y DB_PORT=5432.
DB_HOST=db
DB_PORT=5432
DB_USER=epublit
# Sólo caracteres alfanuméricos: el back arma DATABASE_URL por interpolación
# y una password con @, : o / rompe la URL.
DB_PASS=cambiar_por_una_password_larga_alfanumerica
DB_NAME=epublit
