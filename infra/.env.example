# ---------------------------------------------------------------------------
# Infra de producción de Epublit (refactor).
# Copiar a /home/ubuntu/epublit/.env en el servidor y completar.
# NO commitear.
# ---------------------------------------------------------------------------

# --- Dominio y TLS ---------------------------------------------------------
# Dominio público, sin protocolo (ej: epublit.com.ar).
DOMAIN=epublit.com.ar
# URL pública completa, sin barra final. Es el HOST del back (arma las URLs
# de /files) y el origen permitido por CORS.
PUBLIC_URL=https://epublit.com.ar

# Email para Let's Encrypt (avisos de vencimiento).
LETSENCRYPT_EMAIL=admin@epublit.com.ar
# 1 = entorno de staging de Let's Encrypt (para probar sin gastar límites).
LETSENCRYPT_STAGING=0

# --- Imágenes --------------------------------------------------------------
# La publica .github/workflows/build.yml (rama main -> tag :prod).
BACK_IMAGE=ghcr.io/lautarotetamusa/epublit-back:prod

# --- Postgres --------------------------------------------------------------
POSTGRES_DB=epublit
POSTGRES_USER=epublit
# Usar sólo caracteres alfanuméricos: el back arma DATABASE_URL por
# interpolación y una password con @ / : rompe la URL.
POSTGRES_PASSWORD=cambiar_por_una_password_larga_alfanumerica

# --- Backend ---------------------------------------------------------------
JWT_SECRET=cambiar_por_un_secreto_largo_y_aleatorio
JWT_EXPIRES_IN=24h
# CUIT del padrón de AFIP usado para consultar datos (no es el de cada cuenta).
AFIP_CUIT_PROD=20123456786
TZ=America/Argentina/Buenos_Aires

# --- Directorios del host --------------------------------------------------
# Se reusan los de la app vieja. El contenedor corre como `node` (uid 1000):
# ver el chown del README.
FILES_DIR=/home/Epublit/files
AFIPKEYS_DIR=/home/Epublit/afipkeys
# Carpeta padre del SPA buildeado (nginx monta esta y sirve www/front).
FRONT_DIR=/home/ubuntu/epublit/www

# --- Origen de la migración de datos (app vieja) ---------------------------
# MariaDB publicado en el host por el compose viejo.
LEGACY_DB_HOST=host.docker.internal
LEGACY_DB_PORT=3306
LEGACY_DB_USER=teti
LEGACY_DB_PASSWORD=
LEGACY_DB_NAME=epublit
